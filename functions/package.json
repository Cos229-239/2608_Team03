{
  "name": "arv-functions",
  "private": true,
  "description": "The redeemInvite Cloud Function. The only server-side code in Arv.",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test",
    "test:emulator": "firebase emulators:exec --only functions,firestore --project demo-arv \"node test/redeem.integration.js\"",
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions,firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "firebase-tools": "^14.0.0"
  }
}
