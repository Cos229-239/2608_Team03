<?xml version="1.0" encoding="utf-8"?>
<!--
    The same answer as data_extraction_rules.xml, for the versions that read this file
    instead. Android 11 and below look here; 12 and above look there.

    Redundant with allowBackup="false", deliberately. This app says no to backup three
    times in three places rather than once, for the same reason the permission filter
    checks the family boundary it believes every query already applied: an archive can
    hold the only recording of somebody's voice, and "the other rule covers it" is not
    what that should rest on.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
