<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and below read this file. Android 12 and above read
    data_extraction_rules.xml, which is where the interesting decisions are.

    Before 12 there is one switch for both cloud backup and phone to phone transfer, so
    they cannot be answered separately the way they are on 12 and up. Cloud is the answer
    that has to win: an archive holds health records and recordings of people who cannot
    be asked again, and Auto Backup's 25 MB cap would have skipped the audio and restored
    a database pointing at files that were never uploaded.

    So on these devices nothing is backed up and nothing transfers to a new phone, and the
    export zip in Settings is the only way to move an archive. docs/PRIVACY.md says that
    out loud rather than leaving somebody to discover it on a new handset.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
